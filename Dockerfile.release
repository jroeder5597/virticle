# Used by goreleaser (dockers_v2): the binary is built already and arrives in
# the build context as $TARGETPLATFORM/virticle. For a source build use the
# Dockerfile in the same directory.
FROM --platform=$BUILDPLATFORM alpine:3.20 AS data
RUN mkdir /data

FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/virticle /usr/bin/virticle
COPY --from=data --chown=65532:65532 /data /data
USER 65532:65532
VOLUME /data
EXPOSE 8443 8080
# A data volume from 0.2.0 (an administrator, no stored web settings) keeps
# answering on 0.0.0.0:8080 over HTTPS, where the 0.2.0 image did, until a mode
# is chosen on the Web access page.
ENV VIRTICLE_UPGRADE_LISTEN=0.0.0.0:8080
ENTRYPOINT ["/usr/bin/virticle"]
CMD ["-data", "/data"]
