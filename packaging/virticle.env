# Configuration of the virticle service. Read by systemd (as root) before the
# service starts; kept across package upgrades. Restart after editing:
#   systemctl restart virticle

# The web address, certificate and ports are set on the Web access page of the
# web UI (Settings menu), or from the command line with "virticle web set".
# Extra command line flags, for example -no-scheduler. See "virticle -help".
VIRTICLE_ARGS=

# Password for node jump hosts (user@host in the node dialog). No quotes.
#VIRTICLE_JUMP_PASSWORD=
