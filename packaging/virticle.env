# Configuration of the virticle service. Read by systemd (as root) before the
# service starts; kept across package upgrades. Restart after editing:
#   systemctl restart virticle

# Extra command line flags. The service already passes "-data /var/lib/virticle"
# and listens on 127.0.0.1:8080 (the default of -listen). See "virticle -help".
# Examples:
#   VIRTICLE_ARGS=-listen 127.0.0.1:8080 -no-scheduler
#   VIRTICLE_ARGS=-listen 0.0.0.0:8443 -tls-cert /etc/virticle/tls.pem -tls-key /etc/virticle/tls.key
#   VIRTICLE_ARGS=-listen 127.0.0.1:8080 -trusted-proxy 127.0.0.1
# The service user "virticle" must be able to read the certificate and key.
# A port below 1024 needs the capability drop-in described in virticle.service.
VIRTICLE_ARGS=

# Password for node jump hosts (user@host in the node dialog). No quotes.
#VIRTICLE_JUMP_PASSWORD=
