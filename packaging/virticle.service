[Unit]
Description=Virticle controller for KVM/libvirt hosts
Documentation=man:virticle(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=virticle
Group=virticle
# Extra flags and secrets (VIRTICLE_JUMP_PASSWORD) go in this file; see its
# comments. The web address is set on the Web access page.
EnvironmentFile=-/etc/virticle/virticle.env
ExecStart=/usr/bin/virticle -data /var/lib/virticle $VIRTICLE_ARGS
Restart=on-failure
RestartSec=5

# Database, SSH key and known_hosts live here: /var/lib/virticle.
StateDirectory=virticle
StateDirectoryMode=0700
UMask=0077

# Hardening. The controller needs outbound TCP (SSH to nodes, webhooks) and
# its state directory and the read-only list of network interfaces, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/virticle
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK: Go reads the interface list (the Interface choice on the Web
# access page, the machine's addresses) over netlink; without it the list is empty.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Only the right to listen on ports below 1024 (443 and 80), so that the Web
# access page can use them. Nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
