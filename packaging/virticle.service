[Unit]
Description=Virticle controller for KVM/libvirt hosts
Documentation=man:virticle(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=virticle
Group=virticle
# Extra flags (for example -listen, -tls-cert, -tls-key, -trusted-proxy) and
# secrets (VIRTICLE_JUMP_PASSWORD) go in this file; see its comments.
EnvironmentFile=-/etc/virticle/virticle.env
ExecStart=/usr/bin/virticle -data /var/lib/virticle $VIRTICLE_ARGS
Restart=on-failure
RestartSec=5

# Database, SSH key and known_hosts live here: /var/lib/virticle.
StateDirectory=virticle
StateDirectoryMode=0700
UMask=0077

# Hardening. The controller needs outbound TCP (SSH to nodes, webhooks) and
# its state directory, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/virticle
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# No capabilities. To listen on a port below 1024 (80, 443), add a drop-in with
# "systemctl edit virticle":
#   [Service]
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
