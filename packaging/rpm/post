#!/bin/sh
# Like the DEB: a new install enables and starts the service, an upgrade
# restarts it when it is running. The firewall is not changed here: the
# administrator runs "sudo virticle setup".
if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	if [ "$1" -ge 2 ]; then
		systemctl try-restart virticle.service || true
	else
		systemctl enable virticle.service || true
		systemctl start virticle.service || true
	fi
elif [ "$1" -lt 2 ]; then
	systemctl enable virticle.service 2>/dev/null || true
fi
if [ "$1" -lt 2 ]; then
	echo "Virticle is installed. Run: sudo virticle setup"
	echo "Then open the address it prints."
fi
exit 0
